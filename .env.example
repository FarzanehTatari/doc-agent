# Copy this file to `.env` (which is gitignored) and fill in real values.

# REQUIRED — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — only change if you're routing through a proxy
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional — model to use by default
# Choices: claude-opus-4-7 | claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5
AI_MODEL=claude-opus-4-7

# Optional — DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional — where conversation history / facts / session state live.
# Relative paths resolve against the repo root. Default = project_lib/
DATA_DIR=project_lib

# Optional — memory budgeting for the chat loop
MAX_HISTORY=12                # max user+assistant messages to keep in context
MAX_TOKEN_BUDGET=40000        # total tokens reserved for input messages
RESPONSE_TOKEN_BUDGET=8000    # tokens reserved for the model's reply
FACTS_TOKEN_BUDGET=2000       # tokens reserved for authoritative facts block

# Optional — RAG settings
RAG_ENABLED=1                 # 0 to disable retrieval entirely
RAG_CHUNK_SIZE=800            # target tokens per chunk
RAG_CHUNK_OVERLAP=100         # tokens of overlap between adjacent chunks
RAG_TOP_K=5                   # how many chunks to retrieve per chat turn
RAG_TOKEN_BUDGET=4000         # max tokens of retrieved context to inject
RAG_MIN_SCORE=0.0             # minimum cosine similarity (0..1) to keep a chunk
RAG_COLLECTION=doc_agent_rag  # chromadb collection name

# Optional — MATLAB bridge (Phase 2)
# Leave blank to auto-detect (PATH then /Applications/MATLAB_R*.app/bin/matlab on macOS).
MATLAB_EXECUTABLE=
MATLAB_TIMEOUT_S=300          # max seconds for any MATLAB call
